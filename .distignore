# Files to exclude from the distribution ZIP.
# Do not exclude languages/ or vendor/ — both are required at runtime.
.git
.github
.gitattributes
.gitignore
.distignore

# Internal docs (keep readme.txt)
*.md

# Dev tooling and scripts
tests/
tools/
bin/
phpcs.xml
phpcs.xml.dist
.phpcs.xml
.phpcs.xml.dist
phpunit.xml
phpunit.xml.dist
# composer.json ships with vendor/ so Plugin Check can see the package list.
# composer.lock is used only at build time.
composer.lock
composer.phar
package.json
package-lock.json
package*.json
npm-shrinkwrap.json
node_modules/
phpstan.neon
phpstan.neon.dist
Makefile
*.sh

# WordPress.org marketing assets live in SVN /assets, not trunk
assets/

# Local / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
.env
